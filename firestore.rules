rules_version = '2';

// Règles de sécurité Firestore pour Pile-poil.
// À coller dans la console Firebase → Firestore Database → Règles.
service cloud.firestore {
  match /databases/{database}/documents {

    // Une session = un document dont l'identifiant est le code à 4 caractères.
    match /sessions/{code} {
      function validCode() {
        return code.matches('^[A-HJ-NP-Z2-9]{4}$');
      }
      function validShape() {
        return request.resource.data.keys().hasOnly([
          'code', 'createdAt', 'maxL', 'dares', 'players', 'phase',
          'deck', 'idx', 'answers', 'results', 'round', 'expireAt'
        ])
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt <= request.time + duration.value(49, 'h');
      }

      // Lire une session dont on connaît le code : oui, tant qu'elle a moins de 48 h
      // d'inactivité. Passé ce délai, elle devient illisible pour tout le monde.
      // Lister toutes les sessions : non (personne ne peut parcourir les codes).
      allow get: if validCode() && (resource == null || resource.data.expireAt > request.time);
      allow list: if false;

      // Une session expirée peut être écrasée par une nouvelle partie qui tire le même code.
      allow create, update: if validCode() && validShape();

      // Quitter la partie efface la session pour les deux joueurs.
      allow delete: if validCode();
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
